{
  "expo": {
    "scheme": "sermon-recall",
    "name": "SermonRecall",
    "slug": "sermon-recall",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/brand/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.faithbasedretention.sermonrecall",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record a short voice note for your application commitment."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "backgroundColor": "#021635"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.antoineassociates.sermonrecall"
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-mark.png",
          "imageWidth": 140,
          "backgroundColor": "#070b12",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/brand/splash-mark.png",
            "backgroundColor": "#070b12"
          }
        }
      ],
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#0057EE",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/withExpoSwift5Podfile.js",
      "./plugins/withNoBackgroundAudio.js"
    ],
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d7e3e8a9-6c39-41df-8363-534cb21b7f3c"
      }
    },
    "owner": "urgimeaso"
  }
}
